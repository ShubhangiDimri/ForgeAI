# Backend environment variables (keep real keys in backend/.env, never commit)
GROQ_API_KEY=
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
# Select a numbered Groq credential explicitly if needed
# FORGE_GROQ_KEY_SLOT=2
NVIDIA_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
FORGE_MODEL=groq:openai/gpt-oss-120b
FORGE_JUDGE_MODEL=groq:openai/gpt-oss-20b
FORGE_EMBEDDING=sentence-transformers/all-MiniLM-L6-v2
FORGE_FALLBACK_PROVIDERS=groq,cloudflare,nvidia
FORGE_OLLAMA_URL=http://127.0.0.1:11434
